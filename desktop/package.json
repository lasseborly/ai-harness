    "test:versions": "node scripts/verify-versions.cjs",
    "test:library-loading": "node scripts/verify-library-loading.cjs",
    "test:app-skills": "node scripts/verify-app-skills.cjs",
    "test:features": "node scripts/verify-features.cjs",
    "measure:screens": "node scripts/measure-screens.cjs",
    "test:integrations": "node scripts/verify-integrations.cjs",
    "test:workspace": "node scripts/verify-workspace.cjs",
    "test:planning": "node scripts/verify-planning.cjs",
    "test:approvals": "node scripts/verify-approvals.cjs",
    "test:preview-edit": "node scripts/verify-preview-edit.cjs",
    "test:history": "node scripts/verify-history.cjs",
