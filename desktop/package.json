    "test:agent": "node scripts/verify-agent.cjs",
    "test:chat": "node scripts/verify-chat.cjs",
    "test:chat-feedback": "node scripts/verify-chat-feedback.cjs",
    "test:conversation-progress": "node scripts/verify-conversation-progress.cjs",
    "test:layout": "node scripts/verify-layout.cjs",
    "test:connections": "node scripts/verify-connections.cjs",
    "test:openai-azure": "node scripts/verify-openai-azure.cjs",
    "test:mistral": "node scripts/verify-mistral.cjs",
    "test:live": "node scripts/verify-live-agent.cjs",
    "test:setup": "node scripts/verify-setup.cjs",
    "test:hosting": "node scripts/verify-hosting.cjs",
