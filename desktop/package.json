  "author": "AI Alliancen",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@opencode-ai/plugin": "1.18.33",
    "electron-updater": "6.8.9",
    "semver": "7.8.5"
  }
